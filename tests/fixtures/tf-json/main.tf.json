{
  "provider": {"aws": {"region": "us-east-1"}},
  "variable": {"name": {"default": "orders"}},
  "locals": {"table_name": "${var.name}-table"},
  "resource": {
    "aws_dynamodb_table": {"orders": {"name": "${local.table_name}", "hash_key": "id", "billing_mode": "PAY_PER_REQUEST"}},
    "aws_lambda_function": {"api": {
      "function_name": "api-${var.name}", "runtime": "python3.12", "handler": "app.handler", "memory_size": 512,
      "environment": {"variables": {"TABLE": "${aws_dynamodb_table.orders.name}", "GREETING": "hello \"world\""}}
    }}
  }
}
